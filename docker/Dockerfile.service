FROM golang:1.25-alpine AS builder

ARG SERVICE
ARG VERSION=dev
ARG GIT_COMMIT=unknown

WORKDIR /workspace

COPY pkg/model/ ./pkg/model/
COPY services/${SERVICE}/ ./services/${SERVICE}/
WORKDIR /workspace/services/${SERVICE}
RUN GOWORK=off go mod tidy && \
    CGO_ENABLED=0 GOWORK=off go build \
      -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${GIT_COMMIT}" \
      -o /nexacloud-service ./cmd/

FROM alpine:3.20

RUN apk add --no-cache ca-certificates curl

WORKDIR /app

COPY --from=builder /nexacloud-service /usr/local/bin/nexacloud-service

USER 10001:10001

EXPOSE 8080

ENTRYPOINT ["nexacloud-service"]
